/* ==========================================================================
   GEO Tool — Design System
   Clean B2B SaaS — Inter Font — Professional Analytics
   ========================================================================== */

@import url('https://use.typekit.net/dnn1xoa.css');
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&family=JetBrains+Mono:wght@400;700&display=swap');

/* ── Tokens ──────────────────────────────────────────────────────────────── */
:root {
  /* Core Palette */
  --dark-blue:   #112532;
  --slate-blue:  #88A5B7;
  --warm-gold:   #FACC15;
  --burnt-orange:#E0680E;
  
  --white:       #FFFFFF;
  --off-white:   #F8FAFC;
  --gray-100:    #F1F5F9;
  --gray-200:    #E2E8F0;
  --gray-400:    #94A3B8;
  --gray-600:    #475569;
  
  /* Map legacy brutalism vars to new palette for backwards compatibility in TSX */
  --black:       var(--dark-blue);
  --indigo:      var(--warm-gold);
  --indigo-dim:  rgba(250, 204, 21, 0.1);

  /* Severity palette */
  --p0-bg:       rgba(224, 104, 14, 0.1);
  --p0-text:     var(--burnt-orange);
  --p1-bg:       rgba(250, 204, 21, 0.15);
  --p1-text:     #D97706;
  --p2-bg:       rgba(136, 165, 183, 0.15);
  --p2-text:     var(--dark-blue);
  --p3-bg:       #F1F5F9;
  --p3-text:     #475569;

  --border:      1px solid rgba(136, 165, 183, 0.25);
  --border-dim:  1px solid rgba(136, 165, 183, 0.15);

  --font-display:"fenway-banner-vf", sans-serif;
  --font-sans:   'Inter', system-ui, -apple-system, sans-serif;
  --font-mono:   'JetBrains Mono', 'Courier New', monospace;

  --radius:      16px;
  --radius-sm:   10px;
  --radius-full: 9999px;
  
  --transition:  all 250ms cubic-bezier(0.4, 0, 0.2, 1);
  --shadow-sm:   0 2px 8px rgba(17, 37, 50, 0.04);
  --shadow-md:   0 8px 24px rgba(17, 37, 50, 0.08);
  --shadow-glass:0 12px 40px rgba(17, 37, 50, 0.06);
}

/* ── Reset ───────────────────────────────────────────────────────────────── */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-sans);
  background: #FFFFFF;
  color: var(--dark-blue);
  line-height: 1.5;
  position: relative;
  min-height: 100vh;
}

html,
body {
  width: 100%;
  max-width: 100%;
  overflow-x: clip;
}

img,
svg {
  max-width: 100%;
}

/* No ambient mesh — sections define their own backgrounds */

/* ── Typography ──────────────────────────────────────────────────────────── */
h1, h2, h3, h4 {
  font-family: var(--font-display);
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: var(--dark-blue);
}

.mono {
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
}

/* ── Layout ──────────────────────────────────────────────────────────────── */
.container {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ── Navigation ──────────────────────────────────────────────────────────── */
.nav {
  position: sticky;
  top: 16px;
  z-index: 100;
  margin: 0 24px;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.8);
  box-shadow: var(--shadow-sm);
  height: 64px;
  display: flex;
  align-items: center;
}

.nav__inner {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 32px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav__logo {
  font-weight: 800;
  font-size: 1.25rem;
  letter-spacing: -0.02em;
  text-decoration: none;
  color: var(--dark-blue);
  display: flex;
  align-items: center;
  gap: 12px;
}

.nav__logo span {
  color: var(--warm-gold);
}

.nav__links {
  display: flex;
  gap: 32px;
  list-style: none;
}

.nav__links a {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--gray-600);
  text-decoration: none;
  transition: color var(--transition);
}

.nav__links a:hover { color: var(--dark-blue); }

.nav__actions {
  display: flex;
  gap: 12px;
}

/* ── Buttons ─────────────────────────────────────────────────────────────── */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 24px;
  font-family: var(--font-sans);
  font-size: 0.9rem;
  font-weight: 600;
  text-decoration: none;
  cursor: pointer;
  border-radius: var(--radius-full);
  border: none;
  transition: var(--transition);
  white-space: nowrap;
}

.btn:active { transform: scale(0.98); }

.btn--primary {
  background: linear-gradient(135deg, var(--warm-gold), #d97706);
  color: var(--white);
  box-shadow: 0 4px 14px rgba(250, 204, 21, 0.3);
}

.btn--primary:hover {
  box-shadow: 0 6px 20px rgba(250, 204, 21, 0.4);
  transform: translateY(-1px);
}

.btn--ghost {
  background: rgba(136, 165, 183, 0.1);
  color: var(--dark-blue);
}

.btn--ghost:hover {
  background: rgba(136, 165, 183, 0.2);
}

.btn--indigo {
  background: var(--dark-blue);
  color: var(--white);
  box-shadow: 0 4px 14px rgba(17, 37, 50, 0.2);
}

.btn--indigo:hover {
  box-shadow: 0 6px 20px rgba(17, 37, 50, 0.3);
  transform: translateY(-1px);
}

.btn--lg {
  padding: 14px 32px;
  font-size: 1rem;
}

.btn--full { width: 100%; justify-content: center; }

/* ── Cards (Glassmorphism) ───────────────────────────────────────────────── */
.card {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: var(--radius);
  padding: 32px;
  box-shadow: var(--shadow-glass);
  transition: var(--transition);
}

.card:hover { 
  box-shadow: 0 16px 48px rgba(17, 37, 50, 0.08);
  border-color: rgba(255, 255, 255, 1);
}

.card--flat { padding: 0; }

.card__label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--slate-blue);
  margin-bottom: 8px;
}

.card__value {
  font-size: 2.5rem;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  color: var(--dark-blue);
}

/* ── Score Ring ──────────────────────────────────────────────────────────── */
.score-ring {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
}

.score-ring__svg { overflow: visible; filter: drop-shadow(0 4px 12px rgba(250,204,21,0.2)); }

.score-ring__track {
  fill: none;
  stroke: rgba(136, 165, 183, 0.2);
  stroke-width: 10;
}

.score-ring__fill {
  fill: none;
  stroke: var(--warm-gold);
  stroke-width: 10;
  stroke-linecap: round;
  transition: stroke-dashoffset 1.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.score-ring__fill--low    { stroke: var(--burnt-orange); filter: drop-shadow(0 4px 12px rgba(224,104,14,0.3)); }
.score-ring__fill--medium { stroke: var(--warm-gold); }
.score-ring__fill--good   { stroke: #10B981; filter: drop-shadow(0 4px 12px rgba(16,185,129,0.3)); }
.score-ring__fill--strong { stroke: #059669; }

.score-ring__center {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.score-ring__number {
  font-size: 3rem;
  font-weight: 900;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.04em;
  color: var(--dark-blue);
}

.score-ring__denom {
  font-size: 0.9rem;
  color: var(--slate-blue);
  font-weight: 600;
}

/* ── Metric Pills ────────────────────────────────────────────────────────── */
.metric-pill {
  border: var(--border);
  background: rgba(255,255,255,0.4);
  border-radius: var(--radius-sm);
  padding: 16px 20px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.metric-pill__label {
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--slate-blue);
}

.metric-pill__value {
  font-size: 1.75rem;
  font-weight: 800;
  letter-spacing: -0.02em;
  font-variant-numeric: tabular-nums;
  color: var(--dark-blue);
}

/* ── Bar Component ───────────────────────────────────────────────────────── */
.bar-row {
  display: grid;
  grid-template-columns: 200px 1fr 60px;
  align-items: center;
  gap: 20px;
  padding: 12px 0;
  border-bottom: var(--border-dim);
}

.bar-row:last-child { border-bottom: none; }

.bar-row__label {
  font-size: 0.9rem;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.bar-row__track {
  height: 8px;
  background: rgba(136, 165, 183, 0.15);
  border-radius: var(--radius-full);
  position: relative;
  overflow: hidden;
}

.bar-row__fill {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: var(--dark-blue);
  border-radius: var(--radius-full);
  transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
}

.bar-row__fill--accent { background: var(--warm-gold); }

.bar-row__score {
  font-size: 0.9rem;
  font-weight: 700;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* ── Gap Cards ───────────────────────────────────────────────────────────── */
.gap-card {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(16px);
  border: var(--border);
  border-radius: var(--radius);
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 12px;
  transition: var(--transition);
  box-shadow: var(--shadow-sm);
}

.gap-card:hover { 
  box-shadow: var(--shadow-md); 
  border-color: rgba(250, 204, 21, 0.4); 
}

.gap-card__header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.severity-badge {
  display: inline-flex;
  align-items: center;
  padding: 4px 10px;
  font-size: 0.7rem;
  font-weight: 800;
  font-family: var(--font-mono);
  letter-spacing: 0.05em;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.severity-badge--p0 { background: var(--p0-bg); color: var(--p0-text); }
.severity-badge--p1 { background: var(--p1-bg); color: var(--p1-text); }
.severity-badge--p2 { background: var(--p2-bg); color: var(--p2-text); }
.severity-badge--p3 { background: var(--p3-bg); color: var(--p3-text); }

.gap-card__title {
  font-size: 1.05rem;
  font-weight: 700;
  line-height: 1.4;
  color: var(--dark-blue);
}

.gap-card__evidence {
  font-size: 0.85rem;
  color: var(--slate-blue);
  font-family: var(--font-mono);
}

.gap-card__action {
  font-size: 0.85rem;
  font-weight: 600;
  padding: 12px 16px;
  background: rgba(136, 165, 183, 0.05);
  border-radius: var(--radius-sm);
  border-left: 3px solid var(--warm-gold);
}

.gap-card__meta {
  display: flex;
  gap: 16px;
  font-size: 0.8rem;
  color: var(--gray-400);
  font-weight: 500;
}

/* ── Table ───────────────────────────────────────────────────────────────── */
.data-table {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
}

.data-table th {
  background: rgba(17, 37, 50, 0.03);
  color: var(--slate-blue);
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 12px 20px;
  text-align: left;
  border-bottom: var(--border-dim);
}

.data-table th:first-child { border-top-left-radius: var(--radius-sm); }
.data-table th:last-child { border-top-right-radius: var(--radius-sm); }
.data-table th:not(:first-child) { text-align: right; }

.data-table td {
  padding: 16px 20px;
  font-size: 0.9rem;
  border-bottom: var(--border-dim);
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}

.data-table td:not(:first-child) { text-align: right; }

.data-table tr.is-brand {
  background: rgba(250, 204, 21, 0.05);
  font-weight: 700;
}

.data-table tr.is-brand td:first-child {
  position: relative;
}
.data-table tr.is-brand td:first-child::before {
  content: "";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 4px;
  background: var(--warm-gold);
}

.data-table tr:hover:not(.is-brand) { background: rgba(255, 255, 255, 0.4); }

/* ── Section ─────────────────────────────────────────────────────────────── */
.section {
  padding: 64px 0;
  border-bottom: var(--border-dim);
}

.section:last-child { border-bottom: none; }

.section__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 32px;
  gap: 16px;
}

.section__title {
  font-size: 1.2rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--dark-blue);
}

.section__subtitle {
  font-size: 0.9rem;
  color: var(--slate-blue);
  font-weight: 600;
}

/* ── Form Inputs ─────────────────────────────────────────────────────────── */
.input-group {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.input-label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--slate-blue);
}

.input-field {
  font-family: var(--font-sans);
  font-size: 1rem;
  font-weight: 500;
  padding: 14px 20px;
  background: rgba(255, 255, 255, 0.5);
  border: 1px solid rgba(136, 165, 183, 0.3);
  border-radius: var(--radius-sm);
  color: var(--dark-blue);
  outline: none;
  width: 100%;
  transition: var(--transition);
  box-shadow: inset 0 2px 4px rgba(17,37,50,0.02);
}

.input-field::placeholder { color: var(--gray-400); }

.input-field:focus { 
  border-color: var(--warm-gold);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(250, 204, 21, 0.2);
}

/* ── Hero ────────────────────────────────────────────────────────────────── */
.hero {
  padding: 100px 0 80px;
}

.hero__eyebrow {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--burnt-orange);
  background: rgba(224, 104, 14, 0.1);
  border-radius: var(--radius-full);
  padding: 6px 16px;
  margin-bottom: 24px;
}

.hero__title {
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: -0.03em;
  max-width: 760px;
  margin-bottom: 24px;
  color: var(--dark-blue);
}

.hero__title em {
  font-style: normal;
  background: linear-gradient(135deg, var(--burnt-orange), var(--warm-gold));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.hero__sub {
  font-size: 1.2rem;
  color: var(--gray-600);
  max-width: 560px;
  line-height: 1.6;
  margin-bottom: 48px;
}

/* ── Audit Form ──────────────────────────────────────────────────────────── */
.audit-form {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: var(--radius);
  padding: 40px;
  max-width: 680px;
  box-shadow: var(--shadow-glass);
}

.audit-form__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}

.audit-form__row {
  margin-bottom: 24px;
}

/* ── Stats Strip ─────────────────────────────────────────────────────────── */
.stats-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: var(--border-dim);
  background: rgba(255,255,255,0.4);
  backdrop-filter: blur(12px);
  border-radius: 0 0 var(--radius) var(--radius);
}

.stat-item {
  padding: 32px 24px;
  border-right: var(--border-dim);
}

.stat-item:last-child { border-right: none; }

.stat-item__num {
  font-size: 2.75rem;
  font-weight: 800;
  letter-spacing: -0.04em;
  color: var(--dark-blue);
  display: block;
}

.stat-item__label {
  font-size: 0.85rem;
  color: var(--slate-blue);
  font-weight: 600;
  margin-top: 4px;
}

/* ── Report Header ───────────────────────────────────────────────────────── */
.report-header {
  padding: 24px 0;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(24px);
  border-bottom: 1px solid rgba(255,255,255,0.4);
  position: sticky;
  top: 90px;
  z-index: 50;
  border-radius: var(--radius);
  margin-bottom: 32px;
  box-shadow: 0 4px 20px rgba(17,37,50,0.03);
}

.report-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 0 24px;
}

.report-header__meta {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.report-header__org {
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.report-header__url {
  font-size: 0.8rem;
  color: var(--slate-blue);
  font-family: var(--font-mono);
}

.visibility-tag {
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  border-radius: var(--radius-full);
  background: rgba(17,37,50,0.05);
}

.visibility-tag--verylow  { color: var(--dark-blue); }
.visibility-tag--low      { color: #dc2626; background: rgba(220,38,38,0.1); }
.visibility-tag--moderate { color: var(--burnt-orange); background: rgba(224,104,14,0.1); }
.visibility-tag--good     { color: #059669; background: rgba(5,150,105,0.1); }
.visibility-tag--strong   { color: #059669; background: rgba(5,150,105,0.1); }

/* ── Grid helpers ────────────────────────────────────────────────────────── */
.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

/* ── Progress / Loading ──────────────────────────────────────────────────── */
.progress-bar {
  height: 4px;
  background: rgba(136, 165, 183, 0.1);
  overflow: hidden;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 200;
}

.progress-bar__fill {
  height: 100%;
  background: linear-gradient(90deg, var(--warm-gold), var(--burnt-orange));
  animation: progress 2s ease-in-out infinite;
}

@keyframes progress {
  0%   { width: 0; transform: translateX(-100%); }
  50%  { width: 60%; transform: translateX(0); }
  100% { width: 100%; transform: translateX(100%); }
}

/* ── Audit Status ────────────────────────────────────────────────────────── */
.audit-status {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  gap: 32px;
  text-align: center;
}

.audit-status__steps {
  display: flex;
  flex-direction: column;
  gap: 8px;
  width: 100%;
  max-width: 480px;
}

.step-item {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 24px;
  background: rgba(255,255,255,0.6);
  border-radius: var(--radius-sm);
  font-size: 0.95rem;
  font-weight: 600;
  border: var(--border-dim);
}

.step-item__dot {
  width: 10px;
  height: 10px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--gray-200);
}

.step-item--done   .step-item__dot { background: #10B981; }
.step-item--active .step-item__dot { background: var(--warm-gold); animation: pulse 1.5s ease infinite; box-shadow: 0 0 10px rgba(250,204,21,0.5); }
.step-item--done { color: var(--slate-blue); }
.step-item--active { color: var(--dark-blue); background: rgba(255,255,255,0.9); box-shadow: var(--shadow-sm); }
.step-item--pending { color: var(--gray-400); }

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ── Recommendation Items ────────────────────────────────────────────────── */
.rec-item {
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 16px;
  padding: 24px 0;
  border-bottom: var(--border-dim);
  align-items: start;
}

.rec-item:last-child { border-bottom: none; }

.rec-item__num {
  font-size: 2.2rem;
  font-weight: 800;
  color: var(--slate-blue);
  opacity: 0.3;
  font-variant-numeric: tabular-nums;
  line-height: 1;
}

.rec-item__text {
  font-size: 0.95rem;
  font-weight: 500;
  line-height: 1.6;
}

/* ── Citation Bars ───────────────────────────────────────────────────────── */
.citation-row {
  display: grid;
  grid-template-columns: 160px 1fr 50px;
  align-items: center;
  gap: 16px;
  padding: 10px 0;
}

.citation-row__domain {
  font-size: 0.85rem;
  font-family: var(--font-mono);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.citation-row__bar {
  height: 8px;
  background: rgba(136, 165, 183, 0.15);
  border-radius: var(--radius-full);
  position: relative;
}

.citation-row__fill {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  background: var(--slate-blue);
  border-radius: var(--radius-full);
}

.citation-row__pct {
  font-size: 0.8rem;
  font-weight: 700;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* ── Error / Empty ───────────────────────────────────────────────────────── */
.empty-state {
  padding: 64px 24px;
  text-align: center;
  color: var(--slate-blue);
  font-weight: 600;
  background: rgba(255,255,255,0.4);
  border-radius: var(--radius);
  border: 1px dashed rgba(136,165,183,0.3);
}

.error-box {
  border-radius: var(--radius-sm);
  padding: 16px 20px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  font-size: 0.875rem;
  font-weight: 600;
  color: #991b1b;
}

/* ── Responsive ──────────────────────────────────────────────────────────── */
@media (max-width: 1024px) {
  .home-nav__links {
    gap: 20px !important;
  }

  .geo-dashboard__top-links > a,
  .geo-dashboard__top-links > div:not(:last-child) {
    display: none !important;
  }

  .responsive-report-view [style*="grid-template-columns"] {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
}

@media (max-width: 768px) {
  .container { padding: 0 16px; }
  .card { padding: 24px; }
  .audit-form__grid { grid-template-columns: 1fr; }
  .stats-strip { grid-template-columns: 1fr; border-radius: var(--radius); }
  .stats-strip .stat-item { border-right: none; border-bottom: var(--border-dim); }
  .grid-2 { grid-template-columns: 1fr; }
  .grid-3 { grid-template-columns: 1fr; }
  .bar-row { grid-template-columns: 140px 1fr 50px; }
  .report-header__inner { flex-direction: column; align-items: flex-start; }
  .nav__links { display: none; }

  .home-announcement {
    padding: 8px 12px !important;
    font-size: 0.75rem !important;
    line-height: 1.4;
  }

  .home-nav {
    height: 64px !important;
  }

  .home-nav__inner {
    padding: 0 16px !important;
  }

  .home-nav__links {
    display: none !important;
  }

  .home-nav__actions {
    gap: 8px !important;
    flex-wrap: wrap;
    min-width: 0;
    max-width: 100%;
    justify-content: flex-end;
  }

  .home-nav__dashboard {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    max-width: 100%;
    white-space: normal;
    text-align: center;
  }

  .home-nav__actions a {
    padding: 9px 13px !important;
    font-size: 0.82rem !important;
  }

  .landing-hero {
    padding: 56px 16px 64px !important;
  }

  .landing-hero__title {
    font-size: clamp(2.3rem, 13vw, 3.5rem) !important;
    margin-bottom: 18px !important;
  }

  .landing-hero__subtitle {
    font-size: 1rem !important;
    line-height: 1.55 !important;
    margin-bottom: 32px !important;
  }

  .landing-search-shell {
    border-radius: 24px !important;
    margin-bottom: 80px !important;
  }

  .landing-search-form {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px !important;
    padding: 8px !important;
    border-radius: 18px !important;
  }

  .landing-search-input {
    min-height: 44px;
    padding: 0 8px !important;
    font-size: 1rem !important;
  }

  .landing-country__button {
    min-height: 44px;
    padding: 8px 10px !important;
  }

  .landing-search-submit {
    grid-column: 1 / -1;
    width: 100%;
    min-height: 48px;
    margin-left: 0 !important;
  }

  .landing-demo__sidebar {
    display: none !important;
  }

  .landing-demo__body {
    min-height: 0 !important;
  }

  .landing-demo__main {
    padding: 18px !important;
    min-width: 0;
  }

  .landing-demo__header {
    align-items: flex-start !important;
    flex-direction: column;
    gap: 10px;
  }

  .landing-demo__actions {
    width: 100%;
    flex-wrap: wrap;
  }

  .landing-demo__metrics {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 10px !important;
  }

  .landing-demo__content-grid {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  .geo-dashboard__header {
    height: auto !important;
    min-height: 60px;
    padding: 10px 12px !important;
  }

  .geo-dashboard__header-main {
    gap: 8px !important;
    min-width: 0;
  }

  .geo-dashboard__search {
    max-width: none !important;
    min-width: 0;
  }

  .geo-dashboard__search input {
    min-width: 0;
    padding: 0 10px !important;
  }

  .geo-dashboard__search button {
    min-width: 76px;
    padding: 0 12px !important;
  }

  .geo-dashboard__top-links {
    display: none !important;
  }

  .geo-dashboard__body {
    flex-direction: column;
    min-width: 0;
  }

  .geo-dashboard__sidebar {
    width: 100% !important;
    padding: 8px 10px !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 4px;
    overflow-x: auto;
    border-right: 0 !important;
    border-bottom: 1px solid #E5E7EB;
    scrollbar-width: thin;
  }

  .geo-dashboard__sidebar button {
    flex: 0 0 42px;
    margin-bottom: 0 !important;
  }

  .geo-dashboard__main {
    padding: 18px 16px 40px !important;
    min-width: 0;
  }

  .responsive-report-view,
  .geo-structured-report,
  .geo-structured-report > *,
  .geo-structured-report details,
  .geo-structured-report summary {
    min-width: 0;
    max-width: 100%;
  }

  .responsive-report-view [style*="grid-template-columns"],
  .geo-structured-report [style*="grid-template-columns"] {
    grid-template-columns: minmax(0, 1fr) !important;
  }

  .responsive-report-view > [style*="justify-content: space-between"],
  .performing-topics > [style*="justify-content: space-between"] {
    align-items: stretch !important;
    flex-direction: column;
    gap: 12px;
  }

  .responsive-report-view input,
  .responsive-report-view [style*="width: 320px"] {
    width: 100% !important;
    max-width: 100%;
  }

  .responsive-report-view button,
  .geo-structured-report button,
  .audit-form__submit {
    min-height: 44px;
  }

  .responsive-table-scroll {
    overflow-x: auto !important;
    overscroll-behavior-inline: contain;
    -webkit-overflow-scrolling: touch;
  }

  .responsive-table-row {
    min-width: 760px;
  }

  .geo-structured-report {
    gap: 16px !important;
    overflow-wrap: anywhere;
    word-break: normal;
  }

  .geo-structured-report > .report-print-section {
    padding: 20px !important;
  }

  .geo-structured-report h1 {
    font-size: clamp(1.65rem, 8vw, 2rem) !important;
    overflow-wrap: anywhere;
  }

  .geo-structured-report h2 {
    font-size: 1.15rem !important;
  }

  .report-cover__layout,
  .report-cover__tools {
    width: 100%;
  }

  .report-cover__identity,
  .report-cover__metadata {
    width: 100%;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .report-cover__tools {
    align-items: stretch;
    flex-direction: column-reverse;
  }

  .report-cover__score {
    min-width: 0 !important;
    text-align: left !important;
  }

  .report-actions {
    width: 100%;
  }

  .report-actions button {
    flex: 1 1 150px;
    justify-content: center;
    white-space: normal;
  }

  .report-metric,
  .report-evidence-card,
  .report-prompt-evidence,
  .report-recommendation {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .report-metric {
    padding: 16px !important;
  }

  .report-prompt-evidence summary,
  .report-prompt-body,
  .report-prompt-body > div {
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .report-recommendation > div:first-child {
    align-items: flex-start;
    flex-direction: column;
  }

  .data-table-wrap {
    width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .data-table {
    min-width: 640px;
  }
}

@media (max-width: 430px) {
  .home-nav__inner { padding: 0 12px !important; }
  .home-nav__actions { gap: 6px !important; }
  .home-nav__actions a { padding: 8px 10px !important; }
  .landing-hero { padding-inline: 12px !important; }
  .landing-demo__metrics { grid-template-columns: minmax(0, 1fr) !important; }
  .geo-dashboard__main { padding-inline: 12px !important; }
  .geo-structured-report > .report-print-section { padding: 16px !important; }
  .report-actions { flex-direction: column; }
  .report-actions button { width: 100%; flex-basis: auto; }
  .audit-form { padding: 20px; }
  .input-field { min-height: 48px; padding: 12px 14px; }
  .bar-row { grid-template-columns: minmax(0, 1fr) 42px; gap: 8px; }
  .bar-row__label { grid-column: 1 / -1; white-space: normal; }
  .gap-card { padding: 18px; }
  .gap-card__header,
  .gap-card__meta { align-items: flex-start; flex-direction: column; }
  .citation-row { grid-template-columns: minmax(0, 1fr) 44px; gap: 8px; }
  .citation-row__domain { grid-column: 1 / -1; white-space: normal; overflow-wrap: anywhere; }
}

@media (max-width: 360px) {
  .home-announcement strong { display: block; margin-right: 0 !important; }
  .home-nav__actions .home-nav__login { display: none; }
  .landing-country__button { padding-inline: 8px !important; }
  .geo-dashboard__search button { min-width: 68px; font-size: 12px !important; }
}

/* ── Print / PDF ─────────────────────────────────────────────────────────── */
@media print {
  .nav,
  .report-header,
  .btn,
  .dashboard-only,
  .audit-status,
  .progress-bar { 
    display: none !important; 
  }

  .report-actions,
  .geo-structured-report button {
    display: none !important;
  }

  .print-only-block {
    display: block !important;
  }

  body { background: white; }
  body::before, body::after { display: none; }

  .geo-structured-report {
    display: block !important;
    color: #111827;
  }

  .geo-structured-report > .report-print-section {
    margin: 0 0 10mm;
    border-radius: 0 !important;
    box-shadow: none !important;
    break-before: auto;
  }

  .geo-structured-report .report-cover {
    break-after: page;
  }

  .geo-structured-report details > .report-prompt-body {
    display: grid !important;
  }

  .geo-structured-report details {
    break-inside: auto;
  }

  .geo-structured-report summary {
    list-style: none;
  }

  .geo-structured-report a[href] {
    color: #111827 !important;
    text-decoration: none;
  }

  .geo-structured-report table {
    font-size: 8pt;
  }

  .geo-structured-report thead {
    display: table-header-group;
  }

  .geo-structured-report .report-table-row,
  .geo-structured-report .report-keep-together,
  .geo-structured-report .report-recommendation,
  .geo-structured-report .report-metric {
    break-inside: avoid;
  }

  .card, .gap-card {
    border: 1px solid #e2e8f0;
    box-shadow: none;
    background: white;
  }

  .section {
    break-inside: avoid;
    padding: 24px 0;
  }

  .gap-card { break-inside: avoid; }

  @page {
    margin: 20mm 15mm;
    size: A4;
  }
}
