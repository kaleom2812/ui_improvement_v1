\"text-sm font-bold text-ink\",\"children\":\"Halcyon Labs\"}],[\"$\",\"p\",null,{\"className\":\"text-2xs text-ink-3\",\"children\":\"DevTools\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 flex items-baseline gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"data-fig text-lg text-ink-3\",\"children\":47}],[\"$\",\"span\",null,{\"className\":\"text-ink-3\",\"children\":\"→\"}],[\"$\",\"span\",null,{\"className\":\"data-fig text-2xl font-bold text-pos\",\"children\":69}],[\"$\",\"span\",null,{\"className\":\"ml-auto text-2xs text-ink-3\",\"children\":[88,\" days\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 border-t border-line pt-3 text-sm italic text-ink-2\",\"children\":[\"“\",\"Prompt evidence got engineering to prioritise it.\",\"”\"]}]]}]}],[\"$\",\"$L21\",\"Cedar & Vine\",{\"children\":[\"$\",\"div\",null,{\"className\":\"card h-full p-5\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm font-bold text-ink\",\"children\":\"Cedar & Vine\"}],[\"$\",\"p\",null,{\"className\":\"text-2xs text-ink-3\",\"children\":\"DTC\"}],[\"$\",\"div\",null,{\"className\":\"mt-4 flex items-baseline gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"data-fig text-lg text-ink-3\",\"children\":61}],[\"$\",\"span\",null,{\"className\":\"text-ink-3\",\"children\":\"→\"}],[\"$\",\"span\",null,{\"className\":\"data-fig text-2xl font-bold text-pos\",\"children\":78}],[\"$\",\"span\",null,{\"className\":\"ml-auto text-2xs text-ink-3\",\"children\":[90,\" days\"]}]]}],[\"$\",\"p\",null,{\"className\":\"mt-3 border-t border-line pt-3 text-sm italic text-ink-2\",\"children\":[\"“\",\"Doubled our AI-assisted revenue in a quarter.\",\"”\"]}]]}]}]]}]]}]}]\n17:[\"$\",\"section\",null,{\"id\":\"faq\",\"className\":\"scroll-mt-20 site-container py-14\",\"children\":[[\"$\",\"$L1f\",null,{\"eyebrow\":\"FAQ\",\"title\":\"Common questions\"}],[\"$\",\"div\",null,{\"className\":\"mx-auto mt-6 max-w-2xl space-y-3\",\"children\":[[\"$\",\"$L22\",\"How is the GEO score calculated?\",{\"summary\":\"How is the GEO score calculated?\",\"children\":\"Weighted dimensions — AI Visibility, Brand Prominence, Recommendation Performance, Competitive Position, Citation Visibility, Authority & Trust, Technical GEO and Entity Consistency — each scored 0–100 and calibrated against a benchmark set. The exact set of dimensions comes from the audit backend.\"}],[\"$\",\"$L22\",\"Which AI models do you test?\",{\"summary\":\"Which AI models do you test?\",\"children\":\"ChatGPT (GPT-4o), Claude, Perplexity, Google AI Overviews / Gemini and Microsoft Copilot, depending on which providers the audit backend is configured to run. Each prompt is run multiple times per model and aggregated.\"}],[\"$\",\"$L22\",\"Do I need an account?\",{\"summary\":\"Do I need an account?\",\"children\":\"You can run a free audit and see your score without signing up. An account is used to save audits and track progress over time.\"}],[\"$\",\"$L22\",\"What is the difference between GEO and SEO?\",{\"summary\":\"What is the difference between GEO and SEO?\",\"children\":\"SEO optimises for ranked links on a results page. GEO optimises for being cited, recommended and represented accurately inside an AI-generated answer, where there is often no list of links at all.\"}],[\"$\",\"$L22\",\"How long does an audit take?\",{\"summary\":\"How long does an audit take?\",\"children\":\"Typically 1–4 minutes. The processing screen shows live status while the backend crawls your site and probes the configured AI engines.\"}],[\"$\",\"$L22\",\"Can I re-run an audit?\",{\"summary\":\"Can I re-run an audit?\",\"children\":\"Yes. Re-running produces a fresh score against the current state of your site and the models.\"}]]}]]}]\n18:[\"$\",\"section\",null,{\"id\":\"methodology\",\"className\":\"scroll-mt-20 border-t border-line bg-subtle/40\",\"children\":[\"$\",\"div\",null,{\"className\":\"site-container py-14\",\"children\":[[\"$\",\"$L1f\",null,{\"eyebrow\":\"Documentation\",\"title\":\"How the audit works\",\"lede\":\"phazeAi measures how large language models and AI answer engines perceive, retrieve and represent a brand. It combines live model probing, citation extraction and a technical crawl.\"}],[\"$\",\"ul\",null,{\"className\":\"mt-6 grid gap-3 sm:grid-cols-2\",\"children\":[[\"$\",\"li\",\"Prompts\",{\"className\":\"rounded-lg border border-line bg-surface p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-2xs font-semibold uppercase tracking-[0.06em] text-ink-3\",\"children\":\"Prompts\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm text-ink-2\",\"children\":\"Buyer-intent prompts derived from keyword research and interviews\"}]]}],[\"$\",\"li\",\"Models\",{\"className\":\"rounded-lg border border-line bg-surface p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-2xs font-semibold uppercase tracking-[0.06em] text-ink-3\",\"children\":\"Models\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm text-ink-2\",\"children\":\"The AI engines the audit backend is configured to run\"}]]}],[\"$\",\"li\",\"Runs\",{\"className\":\"rounded-lg border border-line bg-surface p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-2xs font-semibold uppercase tracking-[0.06em] text-ink-3\",\"children\":\"Runs\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm text-ink-2\",\"children\":\"Each prompt run multiple times per model and aggregated\"}]]}],[\"$\",\"li\",\"Crawl\",{\"className\":\"rounded-lg border border-line bg-surface p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-2xs font-semibold uppercase tracking-[0.06em] text-ink-3\",\"children\":\"Crawl\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm text-ink-2\",\"children\":\"Your site fetched both rendered and raw-HTML\"}]]}],[\"$\",\"li\",\"Scoring\",{\"className\":\"rounded-lg border border-line bg-surface p-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-2xs font-semibold uppercase tracking-[0.06em] text-ink-3\",\"children\":\"Scoring\"}],[\"$\",\"p\",null,{\"className\":\"mt-1 text-sm text-ink-2\",\"children\":\"Weighted dimensions, 0–100, calibrated against a benchmark set\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-8 text-center\",\"children\":[\"$\",\"$L7\",null,{\"href\":\"/audit\",\"className\":\"btn-primary mx-auto\",\"children\":[\"Run a free audit \",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":14,\"height\":14,\"fill\":\"currentColor\",\"viewBox\":\"0 0 256 256\",\"transform\":\"$undefined\",\"children\":[false,\"$undefined\",[\"$\",\"path\",null,{\"d\":\"M224.49,136.49l-72,72a12,12,0,0,1-17-17L187,140H40a12,12,0,0,1,0-24H187L135.51,64.48a12,12,0,0,1,17-17l72,72A12,12,0,0,1,224.49,136.49Z\"}]]}]]}]}]]}]}]\n19:[\"$\",\"$L23\",null,{\"children\":[\"$L24\",[\"$\",\"$L25\",null,{\"promise\":\"$@26\"}]]}]\n1b:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n24:null\n27:I[622,[],\"IconMark\"]\n26:{\"metadata\":[[\"$\",\"title\",\"0\",{\"children\":\"Resources — GEO Tool\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Find out if your brand is visible to AI systems like ChatGPT, Gemini, and Claude. Get a full GEO score with gap analysis and recommendations.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"icon\",\"href\":\"/favicon.ico\",\"type\":\"image/x-icon\",\"sizes\":\"16x16\"}],[\"$\",\"$L27\",\"3\",{}]],\"error\":null,\"digest\":\"$undefined\"}\n1e:\"$26:metadata\"\n"}