{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/(marketing)/layout,_N_T_/(marketing)/product/layout,_N_T_/(marketing)/product/geo-audit/layout,_N_T_/(marketing)/product/geo-audit/page,_N_T_/product/geo-audit"}},"html":"<!DOCTYPE html><!--_DCvnRm1CV0j_8QYl4Bfz--><html lang=\"en\" data-theme=\"dark\" class=\"__variable_246ccd __variable_c29908\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/7ec9f183fc97611d.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-1567fbeaa3f8c7e0.js\"/><script src=\"/_next/static/chunks/4bd1b696-f785427dddbba9fb.js\" async=\"\"></script><script src=\"/_next/static/chunks/1255-a20f6c5e797a687b.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-76e112a2b780d7f5.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-06a92a327b8e7ec9.js\" async=\"\"></script><script src=\"/_next/static/chunks/350-d38aea6845b5c3d5.js\" async=\"\"></script><script src=\"/_next/static/chunks/4420-c88682c21ff08df3.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/(marketing)/layout-f59e6b0935dfb989.js\" async=\"\"></script><script src=\"/_next/static/chunks/4247-90335bd4e09e8669.js\" async=\"\"></script><script src=\"/_next/static/chunks/875-c0fbf62523c4aae4.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/(marketing)/product/geo-audit/page-c08a9f30e33b7c60.js\" async=\"\"></script><title>The GEO Audit — GEO Tool</title><meta name=\"description\" content=\"Find out if your brand is visible to AI systems like ChatGPT, Gemini, and Claude. Get a full GEO score with gap analysis and recommendations.\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"SoftwareApplication\",\"name\":\"GEO Tool\",\"applicationCategory\":\"BusinessApplication\",\"operatingSystem\":\"Web\",\"description\":\"An enterprise Generative Engine Optimization (GEO) platform that audits, measures, and optimizes brand visibility across major AI engines like ChatGPT, Gemini, and Claude.\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"USD\"}},{\"@type\":\"WebSite\",\"name\":\"GEO Tool\"}]}</script><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body><div hidden=\"\"><!--$--><!--/$--></div><div aria-hidden=\"true\" class=\"pointer-events-none fixed inset-0 z-0 overflow-hidden\"><div class=\"absolute inset-0 opacity-50\" style=\"background-image:radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1.4px);background-size:46px 46px;mask-image:radial-gradient(120% 90% at 50% 0%, black 30%, transparent 75%);-webkit-mask-image:radial-gradient(120% 90% at 50% 0%, black 30%, transparent 75%)\"></div><canvas class=\"absolute inset-0 h-full w-full opacity-70\"></canvas><div class=\"absolute inset-0\" style=\"background:radial-gradient(130% 80% at 50% 8%, transparent 40%, rgba(7,9,11,0.55) 78%, #07090B 100%)\"></div></div><div aria-hidden=\"true\" class=\"fixed left-0 top-0 z-nav hidden h-full w-px bg-line lg:block\"><div class=\"absolute left-0 top-0 w-px origin-top bg-signal\" style=\"height:100%;transform:scaleY(0);box-shadow:0 0 12px rgba(74,222,158,0.7)\"></div></div><div class=\"relative z-10\"><a href=\"#main\" class=\"sr-only-focusable fixed left-4 top-3 z-overlay rounded bg-signal px-4 py-2 font-mono text-xs font-semibold uppercase tracking-wide text-canvas\">Skip to content</a><header class=\"sticky top-0 z-40 border-b border-line bg-canvas/85 backdrop-blur\"><div class=\"site-container flex h-16 items-center justify-between gap-4\"><div class=\"flex items-center gap-1\"><a class=\"group inline-flex items-center gap-2.5 no-underline mr-3\" aria-l